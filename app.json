{
  "expo": {
    "name": "Metriqo Invoice",
    "slug": "metriqo-invoice",
    "scheme": "metriqo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.metriqo.invoice",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.metriqo.invoice",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-mail-composer",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Metriqo to access your photos so you can set your business logo."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Metriqo to use Face ID to unlock the app."
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "googleDriveClientId": "",
      "cloudBackupApiUrl": "",
      "eas": {
        "projectId": "a9d05f07-1a63-42f1-b413-608e84464b52"
      }
    },
    "owner": "mubashiraziz39"
  }
}
